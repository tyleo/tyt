{
    "name": "tyt",
    "version": "0.1.0",
    "author": "tyleo",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "scripts": {
        "setup": "git config core.hooksPath .githooks",
        "build:release-wasm": "cargo build",
        "install:tyt": "cargo install --path ./projects/tyt/tyt --features=\"bin\"",
        "install:vmax": "cargo install --path ./projects/tyt/tyt-vmax --features=\"bin\"",
        "install:vxl": "cargo install --path ./projects/utilities/vxl --features=\"bin\""
    }
}