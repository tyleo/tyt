#!/bin/sh
# Checked-in pre-commit hook, shared by humans and Claude.
#
# Activated via core.hooksPath=.githooks, which projects/tyt/tyt-common/build.rs
# sets on the first `cargo check` after a clone. To activate by hand:
#   git config core.hooksPath .githooks
#
# Bypass in an emergency with `git commit --no-verify`.

if ! cargo fmt --all -- --check; then
    echo >&2
    echo "pre-commit: formatting check failed - run 'cargo fmt --all', then re-stage." >&2
    exit 1
fi

if ! cargo clippy --workspace --all-targets -- -D warnings; then
    echo >&2
    echo "pre-commit: clippy reported lints - fix them, then re-commit." >&2
    exit 1
fi

if git diff --cached --name-only | grep -q '^projects/utilities/sdfj-builder/'; then
    if ! command -v deno >/dev/null 2>&1; then
        echo "pre-commit: the commit touches sdfj-builder, whose checks need deno." >&2
        exit 1
    fi
    if ! (cd projects/utilities/sdfj-builder && deno check && deno lint && deno fmt --check && deno test); then
        echo >&2
        echo "pre-commit: sdfj-builder's deno checks failed - fix them, then re-stage." >&2
        exit 1
    fi
fi

if git diff --cached --name-only | grep -q '^projects/utilities/voxrender-bench-quest/'; then
    if ! rustup target list --installed | grep -qx 'aarch64-linux-android'; then
        echo "pre-commit: the commit touches voxrender-bench-quest, whose lints need the aarch64-linux-android target." >&2
        exit 1
    fi
    if ! cargo clippy -p voxrender-bench-quest --target aarch64-linux-android -- -D warnings; then
        echo >&2
        echo "pre-commit: voxrender-bench-quest's Android lints failed - fix them, then re-stage." >&2
        exit 1
    fi
fi
